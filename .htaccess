
RewriteEngine On
RewriteBase /Abimanya-php-frontend/

# Redirect direct /public URLs to clean URLs
RewriteCond %{THE_REQUEST} \s/+Abimanya-php-frontend/public(?:/([^\s?]*))?[\s?] [NC]
RewriteRule ^public/?(.*)$ /Abimanya-php-frontend/$1 [R=302,L,NE]

# Serve existing files inside public (CSS, JS, images)
RewriteCond %{DOCUMENT_ROOT}/Abimanya-php-frontend/public/$1 -f
RewriteRule ^(.+)$ public/$1 [L]

# Send all page requests through the central router
RewriteRule ^ public/index.php [QSA,L]
